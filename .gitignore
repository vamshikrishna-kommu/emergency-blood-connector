# ============================================================
# .gitignore — Files to exclude from version control
# ============================================================

# Dependencies — reinstall with: npm install
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment variable files — NEVER commit these (contain secrets)
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local

# Production build output
frontend/dist/
frontend/build/
dist/
build/

# Test coverage reports
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS & editor junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Development scripts / artifacts not for production
backend/test_db.mjs
