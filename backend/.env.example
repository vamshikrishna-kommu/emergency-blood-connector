# ===============================================
# Emergency Blood Connector — Environment Variables
# ===============================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git.

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
# Note: URL-encode special characters (e.g. @ → %40, # → %23)
DB_URL=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/bloodconnector

# JWT secret key — MUST be a long random string (min 32 characters)
# Generate a secure key with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=your_super_secret_jwt_key_replace_this_with_at_least_64_random_chars

# Backend server port (Render sets this automatically — don't change for production)
PORT=4000

# Frontend URL — used by CORS to allow cookies cross-origin
# Development:  http://localhost:5173
# Production:   https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Node environment
# development → lax cookies, verbose error messages
# production  → secure HTTPS-only cookies, sanitised error responses
NODE_ENV=development
