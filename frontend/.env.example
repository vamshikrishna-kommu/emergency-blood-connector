# ===============================================
# Frontend Environment Variables
# ===============================================
# Copy to .env.local for local overrides
# NEVER commit .env.local to Git

# In development, leave this empty — Vite proxy handles /api/* forwarding
# In production (Netlify/Vercel), set this to your deployed backend URL
# Example: VITE_API_URL=https://your-backend.railway.app
VITE_API_URL=
